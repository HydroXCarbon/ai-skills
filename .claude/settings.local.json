{
  "theme": "dark",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read(./**)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git ls-files*)",
      "Bash(git blame*)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(ls*)",
      "Bash(pwd)",
      "Bash(tree*)",
      "Bash(wc*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(grep*)",
      "Bash(rg*)",
      "Bash(which*)",
      "Bash(npm run test*)",
      "Bash(npm run lint*)",
      "Bash(npm run build*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(npm publish*)",
      "Bash(npm install*)",
      "Bash(docker*)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Read(**/.envrc)",
      "Read(**/*.yaml)",
      "Read(**/*.yml)",
      "Read(**/*.tfvars)",
      "Bash(cat *.env*)",
      "Bash(cat *.yaml*)",
      "Bash(cat *.yml*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(grep *.env*)"
    ],
    "deny": [
      "Read(**/secrets/**)",
      "Read(**/confidential/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)",
      "Read(~/.docker/config.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Bash(rm -rf*)",
      "Bash(sudo*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(chmod 777*)",
      "Bash(docker rm *)",
      "Bash(wget*)",
      "Bash(nc *)",
      "Bash(ssh*)",
      "Bash(scp*)",
      "Bash(* ~/.ssh*)",
      "Bash(* ~/.aws*)",
      "Bash(* ~/.gnupg*)",
      "Bash(* ~/.config/gh*)",
      "Bash(* ~/.kube*)",
      "Bash(* ~/.npmrc*)",
      "Bash(* ~/.netrc*)",
      "Bash(* ~/.docker/config.json*)",
      "Bash(cat *confidential*)"
    ]
  }
}